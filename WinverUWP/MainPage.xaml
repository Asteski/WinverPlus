<Page
    x:Class="WinverUWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:isMicaIncompatible="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsTypeNotPresent(Windows.UI.Composition.ICompositionSupportsSystemBackdrop)"
    xmlns:isShapesCompatible="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsTypePresent(Windows.UI.Composition.CompositionShape)"
    xmlns:isShapesIncompatible="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsTypeNotPresent(Windows.UI.Composition.CompositionShape)"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    mc:Ignorable="d">

    <Grid d:Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" isMicaIncompatible:Background="{ThemeResource SystemControlAcrylicWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Name="TitleBar"
            Height="32"
            Background="Transparent">
            <Button x:Name="SettingsBackButton" x:Uid="SettingsBackButton" Width="40" Height="32"
                HorizontalAlignment="Left" Visibility="Collapsed" BorderThickness="0" Padding="0"
                Click="SettingsBackButton_Click">
                <Button.Resources><SolidColorBrush x:Key="ButtonBackground" Color="Transparent" /></Button.Resources>
                <FontIcon Glyph="&#xE72B;" FontSize="12" />
            </Button>
            <TextBlock
                Name="AppTitle"
                x:Uid="AboutWindows"
                Margin="{StaticResource TitleBarLeftMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />
        </Grid>

        <Viewbox
            x:Name="WindowsBrand"
            Grid.Row="1"
            MaxWidth="300"
            Margin="100,20">
            <Grid>
                <isShapesIncompatible:Path x:Name="NonCompatiblePath" Fill="{ThemeResource ApplicationForegroundThemeBrush}" />
                <isShapesCompatible:Border>
                    <Border x:Name="CompatibleCanvas">
                        <!--  This is only for Designer, not actually loaded in the real UI tree  -->
                        <d:Path Data="{StaticResource Windows11Path}" Fill="{ThemeResource ApplicationForegroundThemeBrush}" />
                    </Border>
                </isShapesCompatible:Border>
            </Grid>
        </Viewbox>

        <ScrollViewer
            x:Name="SpecificationsView"
            Grid.Row="2"
            Margin="10,10,10,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <muxc:Expander x:Name="DeviceExpander" IsExpanded="True" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalAlignment="Top"
                    Collapsed="Expander_Collapsed" Expanding="Expander_Expanding">
                    <muxc:Expander.Header>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock x:Uid="DeviceInfo" TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center" />
                            <Button x:Name="DeviceCopyButton" Grid.Column="2"
                                MinWidth="90" VerticalAlignment="Center" Click="DeviceCopyButton_Click">
                                <Button.Resources>
                                    <Storyboard x:Key="DeviceCopyToClipboardSuccessAnimation" x:Name="DeviceCopyToClipboardSuccessAnimation">
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="DeviceButtonContent"
                                            Storyboard.TargetProperty="(UIElement.Opacity)"
                                            Duration="0:0:1.433">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.33,0.0 0.67,1.0"
                                                    KeyTime="00:00:00.1330000"
                                                    Value="0" />
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:01.3000000" Value="0" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="1.0,0.0 1.0,1.0"
                                                    KeyTime="00:00:01.4330000"
                                                    Value="1" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="DeviceCopyToClipboardTextScaleTransform"
                                            Storyboard.TargetProperty="(ScaleX)"
                                            Duration="0:0:1.2">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.13,0.0 0.0,1.0"
                                                    KeyTime="00:00:00.1330000"
                                                    Value="0.273" />
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:01.1670000" Value="0.273" />
                                                <LinearDoubleKeyFrame KeyTime="00:00:01.2000000" Value="1" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="DeviceCopyToClipboardTextScaleTransform"
                                            Storyboard.TargetProperty="(ScaleY)"
                                            Duration="0:0:1.2">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.13,0.0 0.0,1.0"
                                                    KeyTime="00:00:00.1330000"
                                                    Value="0.273" />
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:01.1670000" Value="0.273" />
                                                <LinearDoubleKeyFrame KeyTime="00:00:01.2000000" Value="1" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="DeviceCopySuccessGlyph"
                                            Storyboard.TargetProperty="(UIElement.Opacity)"
                                            Duration="0:0:1.3">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00.1330000" Value="0" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.33,0.0 0.67,1.0"
                                                    KeyTime="00:00:00.2670000"
                                                    Value="1" />
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:01.1670000" Value="1" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="1.0,0.0 0.98,1.0"
                                                    KeyTime="00:00:01.3000000"
                                                    Value="0" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="DeviceCopyToClipboardSuccessTextScaleTransform"
                                            Storyboard.TargetProperty="(ScaleX)"
                                            Duration="0:0:0.333">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00.1330000" Value="0.385" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.39,0.0 0.63,1.0"
                                                    KeyTime="00:00:00.2670000"
                                                    Value="1.146" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.55,0.0 0.02,1.0"
                                                    KeyTime="00:00:00.3330000"
                                                    Value="1" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="DeviceCopyToClipboardSuccessTextScaleTransform"
                                            Storyboard.TargetProperty="(ScaleY)"
                                            Duration="0:0:0.333">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00.1330000" Value="0.385" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.39,0.0 0.63,1.0"
                                                    KeyTime="00:00:00.2670000"
                                                    Value="1.146" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.55,0.0 0.02,1.0"
                                                    KeyTime="00:00:00.3330000"
                                                    Value="1" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </Button.Resources>
                                <Button.Content>
                                    <Grid>
                                        <Grid.Children>
                                            <ContentPresenter
                                                x:Name="DeviceButtonContent"
                                                HorizontalAlignment="Center"
                                                RenderTransformOrigin=".5,.5">
                                                <ContentPresenter.RenderTransform>
                                                    <ScaleTransform x:Name="DeviceCopyToClipboardTextScaleTransform" />
                                                </ContentPresenter.RenderTransform>
                                                <TextBlock
                                                    x:Uid="CopyButton"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </ContentPresenter>
                                            <ContentPresenter
                                                x:Name="DeviceCopySuccessGlyph"
                                                HorizontalAlignment="Center"
                                                Opacity="0"
                                                RenderTransformOrigin=".5,.5">
                                                <ContentPresenter.RenderTransform>
                                                    <ScaleTransform x:Name="DeviceCopyToClipboardSuccessTextScaleTransform" />
                                                </ContentPresenter.RenderTransform>
                                                <TextBlock
                                                    x:Uid="CopiedButton"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </ContentPresenter>
                                        </Grid.Children>
                                    </Grid>
                                </Button.Content>
                            </Button>
                        </Grid>
                    </muxc:Expander.Header>
                    <Grid Margin="36,0,0,0" ColumnSpacing="20" RowSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="DeviceNameLabel" MaxWidth="160" TextWrapping="Wrap" Grid.Row="0" />
                        <TextBlock x:Name="DeviceName" Grid.Row="0" Grid.Column="1"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            IsTextSelectionEnabled="True" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Uid="ProcessorLabel" MaxWidth="160" TextWrapping="Wrap" Grid.Row="1" />
                        <TextBlock x:Name="Processor" Grid.Row="1" Grid.Column="1"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            IsTextSelectionEnabled="True" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Uid="InstalledRamLabel" MaxWidth="160" TextWrapping="Wrap" Grid.Row="2" />
                        <TextBlock x:Name="InstalledRam" Grid.Row="2" Grid.Column="1"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            IsTextSelectionEnabled="True" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Uid="GraphicsCardLabel" MaxWidth="160" TextWrapping="Wrap" Grid.Row="3" />
                        <TextBlock x:Name="GraphicsCard" Grid.Row="3" Grid.Column="1" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock x:Uid="StorageLabel" MaxWidth="160" TextWrapping="Wrap" Grid.Row="4" />
                        <TextBlock x:Name="Storage" Grid.Row="4" Grid.Column="1" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock x:Uid="DeviceIdLabel" MaxWidth="160" TextWrapping="Wrap" Grid.Row="5" />
                        <TextBlock x:Name="DeviceId" Grid.Row="5" Grid.Column="1"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Grid>
                </muxc:Expander>

                <muxc:Expander
                    x:Name="SpecExpander"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsExpanded="True"
                    Collapsed="Expander_Collapsed"
                    ExpandDirection="Down"
                    Expanding="Expander_Expanding">
                    <muxc:Expander.Header>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Width="18" Height="18" VerticalAlignment="Center"
                                Fill="{ThemeResource ApplicationForegroundThemeBrush}"
                                Data="M0,0 H8.5 V8.5 H0 Z M9.5,0 H18 V8.5 H9.5 Z M0,9.5 H8.5 V18 H0 Z M9.5,9.5 H18 V18 H9.5 Z" />
                            <TextBlock
                                x:Uid="WindowsSpecifications"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="CopyButton"
                                Grid.Column="2"
                                MinWidth="90"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="CopyButton_Click">
                                <Button.Resources>
                                    <Storyboard x:Key="CopyToClipboardSuccessAnimation" x:Name="CopyToClipboardSuccessAnimation">
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="ButtonContent"
                                            Storyboard.TargetProperty="(UIElement.Opacity)"
                                            Duration="0:0:1.433">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.33,0.0 0.67,1.0"
                                                    KeyTime="00:00:00.1330000"
                                                    Value="0" />
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:01.3000000" Value="0" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="1.0,0.0 1.0,1.0"
                                                    KeyTime="00:00:01.4330000"
                                                    Value="1" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="CopyToClipboardTextScaleTransform"
                                            Storyboard.TargetProperty="(ScaleX)"
                                            Duration="0:0:1.2">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.13,0.0 0.0,1.0"
                                                    KeyTime="00:00:00.1330000"
                                                    Value="0.273" />
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:01.1670000" Value="0.273" />
                                                <LinearDoubleKeyFrame KeyTime="00:00:01.2000000" Value="1" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="CopyToClipboardTextScaleTransform"
                                            Storyboard.TargetProperty="(ScaleY)"
                                            Duration="0:0:1.2">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.13,0.0 0.0,1.0"
                                                    KeyTime="00:00:00.1330000"
                                                    Value="0.273" />
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:01.1670000" Value="0.273" />
                                                <LinearDoubleKeyFrame KeyTime="00:00:01.2000000" Value="1" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="CopySuccessGlyph"
                                            Storyboard.TargetProperty="(UIElement.Opacity)"
                                            Duration="0:0:1.3">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00.1330000" Value="0" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.33,0.0 0.67,1.0"
                                                    KeyTime="00:00:00.2670000"
                                                    Value="1" />
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:01.1670000" Value="1" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="1.0,0.0 0.98,1.0"
                                                    KeyTime="00:00:01.3000000"
                                                    Value="0" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="CopyToClipboardSuccessTextScaleTransform"
                                            Storyboard.TargetProperty="(ScaleX)"
                                            Duration="0:0:0.333">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00.1330000" Value="0.385" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.39,0.0 0.63,1.0"
                                                    KeyTime="00:00:00.2670000"
                                                    Value="1.146" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.55,0.0 0.02,1.0"
                                                    KeyTime="00:00:00.3330000"
                                                    Value="1" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="CopyToClipboardSuccessTextScaleTransform"
                                            Storyboard.TargetProperty="(ScaleY)"
                                            Duration="0:0:0.333">
                                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteDoubleKeyFrame KeyTime="00:00:00.1330000" Value="0.385" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.39,0.0 0.63,1.0"
                                                    KeyTime="00:00:00.2670000"
                                                    Value="1.146" />
                                                <SplineDoubleKeyFrame
                                                    KeySpline="0.55,0.0 0.02,1.0"
                                                    KeyTime="00:00:00.3330000"
                                                    Value="1" />
                                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </Button.Resources>
                                <Button.Content>
                                    <Grid>
                                        <Grid.Children>
                                            <ContentPresenter
                                                x:Name="ButtonContent"
                                                HorizontalAlignment="Center"
                                                RenderTransformOrigin=".5,.5">
                                                <ContentPresenter.RenderTransform>
                                                    <ScaleTransform x:Name="CopyToClipboardTextScaleTransform" />
                                                </ContentPresenter.RenderTransform>
                                                <TextBlock
                                                    x:Uid="CopyButton"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </ContentPresenter>
                                            <ContentPresenter
                                                x:Name="CopySuccessGlyph"
                                                HorizontalAlignment="Center"
                                                Opacity="0"
                                                RenderTransformOrigin=".5,.5">
                                                <ContentPresenter.RenderTransform>
                                                    <ScaleTransform x:Name="CopyToClipboardSuccessTextScaleTransform" />
                                                </ContentPresenter.RenderTransform>
                                                <TextBlock
                                                    x:Uid="CopiedButton"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </ContentPresenter>
                                        </Grid.Children>
                                    </Grid>
                                </Button.Content>
                            </Button>
                        </Grid>
                    </muxc:Expander.Header>
                    <Grid
                        Margin="36,0,0,0"
                        HorizontalAlignment="Stretch"
                        ColumnSpacing="20"
                        RowSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="Edition" TextWrapping="Wrap" MaxWidth="160" />
                        <TextBlock
                            Name="Edition"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            d:Text="Windows 11 Pro"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock x:Uid="Version" Grid.Row="1" TextWrapping="Wrap" MaxWidth="160" />
                        <TextBlock
                            Name="Version"
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            d:Text="21H2"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock x:Uid="InstalledOn" Grid.Row="2" TextWrapping="Wrap" MaxWidth="160" />
                        <TextBlock
                            Name="InstalledOn"
                            Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            d:Text="01/01/1970"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock x:Uid="OSBuild" Grid.Row="3" TextWrapping="Wrap" MaxWidth="160" />
                        <TextBlock
                            Name="Build"
                            Grid.Row="3"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            d:Text="22000.1"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Name="ExpirationLabel"
                            x:Uid="Expiration"
                            Grid.Row="5" TextWrapping="Wrap" MaxWidth="160" />
                        <TextBlock
                            Name="Expiration"
                            Grid.Row="5"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            d:Text="01/01/1970"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock x:Uid="Experience" MaxWidth="160" TextWrapping="Wrap" Grid.Row="4" />
                        <TextBlock x:Name="Experience" Grid.Row="4" Grid.Column="1" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Grid>
                </muxc:Expander>

                <muxc:Expander
                    x:Name="LegalExpander"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsExpanded="True"
                    Collapsed="Expander_Collapsed"
                    ExpandDirection="Down"
                    Expanding="Expander_Expanding">
                    <muxc:Expander.Header>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEC08;" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                x:Uid="LegalLabel"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        </Grid>
                    </muxc:Expander.Header>
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock
                            Name="LicensingText"
                            x:Uid="Trademark"
                            HorizontalAlignment="Stretch"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Name="LicenseTo"
                            x:Uid="LicenseTo"
                            Margin="0,20,0,0"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel Margin="0,5,0,0">
                            <TextBlock
                                Name="OwnerText"
                                HorizontalAlignment="Left"
                                d:Text="Windows User"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Name="OrgText"
                                HorizontalAlignment="Left"
                                d:Text="Windows User"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </muxc:Expander>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="SettingsView" Grid.Row="1" Grid.RowSpan="2" Margin="24,28,24,0" Visibility="Collapsed">
            <Grid.ChildrenTransitions><TransitionCollection><EntranceThemeTransition /></TransitionCollection></Grid.ChildrenTransitions>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4" Padding="0,0,0,20">
                    <TextBlock x:Uid="SettingsTitle" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />
                    <TextBlock x:Uid="AppearanceCategory" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <muxc:Expander x:Name="ThemeExpander" MinHeight="68" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <muxc:Expander.Header>
                            <Grid ColumnSpacing="16" Padding="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE790;" FontSize="16" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Uid="AppThemeTitle" />
                                    <TextBlock x:Uid="AppThemeDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </muxc:Expander.Header>
                        <StackPanel Margin="36,0,0,0" Spacing="8">
                            <RadioButton x:Name="LightThemeButton" x:Uid="LightTheme" GroupName="AppTheme" Tag="Light" Checked="Theme_Checked" />
                            <RadioButton x:Name="DarkThemeButton" x:Uid="DarkTheme" GroupName="AppTheme" Tag="Dark" Checked="Theme_Checked" />
                            <RadioButton x:Name="SystemThemeButton" x:Uid="SystemTheme" GroupName="AppTheme" Tag="System" Checked="Theme_Checked" />
                        </StackPanel>
                    </muxc:Expander>
                    <Border Background="{ThemeResource ExpanderHeaderBackground}" BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Height="68">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEC08;" FontSize="16" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="LegalSettingTitle" TextWrapping="Wrap" />
                                <TextBlock x:Uid="LegalSettingDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowLegalToggle" MinWidth="0" HorizontalAlignment="Right" Grid.Column="2" x:Uid="ShowLegalToggle" VerticalAlignment="Center" Toggled="ShowLegalToggle_Toggled" />
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource ExpanderHeaderBackground}" BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Height="68">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE70D;" FontSize="16" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="CollapsibleCardsTitle" TextWrapping="Wrap" />
                                <TextBlock x:Uid="CollapsibleCardsDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CollapsibleCardsToggle" x:Uid="CollapsibleCardsToggle" MinWidth="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="CollapsibleCardsToggle_Toggled" />
                        </Grid>
                    </Border>
                    <TextBlock x:Uid="StartupCategory" TextWrapping="Wrap" Margin="0,16,0,8" />
                    <Border Background="{ThemeResource ExpanderHeaderBackground}" BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Height="68">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE74E;" FontSize="16" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="RememberCardsTitle" TextWrapping="Wrap" />
                                <TextBlock x:Uid="RememberCardsDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RememberCardsToggle" MinWidth="0" HorizontalAlignment="Right" x:Uid="RememberCardsToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="RememberCardsToggle_Toggled" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="3" Margin="10">
            <Button x:Name="SettingsButton" x:Uid="SettingsButton"
                Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0"
                BorderThickness="0" CornerRadius="4"
                HorizontalAlignment="Left" Click="SettingsButton_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemBaseLowColor}" Opacity="0.2" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemBaseLowColor}" Opacity="0.4" />
                </Button.Resources>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="SettingsBackground.Background" Value="{StaticResource ButtonBackgroundPointerOver}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="SettingsBackground.Background" Value="{StaticResource ButtonBackgroundPressed}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="SettingsBackground" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="MoreInfoButton" x:Uid="MoreInfoButton" Click="MoreInfoButton_Click" />
                <Button x:Uid="OKButton" Width="60" Click="Button_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
